# CDMS Backend — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real `.env` (it is gitignored). This file holds PLACEHOLDERS ONLY.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=CDMS Backend
API_PREFIX=api

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/cdms?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate each: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail (Nodemailer) ────────────────────────────────────────────────────────
# Set MAIL_PASS to a 16-char Gmail App Password to enable real email. Until then
# invite/reset links are logged to the backend console (MailService dev mode).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="CDMS <your_email@gmail.com>"

# ─── Google Meet (Google Calendar API) ────────────────────────────────────────
# Fill in to enable real meet.google.com links. Until then virtual events get no
# auto link (dev mode). Mint the refresh token with
# `node scripts/get-google-refresh-token.mjs` after creating an OAuth Desktop client.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary

# ─── Frontend URL (used to build invite/reset links) ──────────────────────────
FRONTEND_URL=http://localhost:8080

# ─── Buyer Portal ─────────────────────────────────────────────────────────────
# "Browse more vehicles" link shown on the public buyer portal. Optional —
# defaults to https://spinauto.ca/cars when unset.
PUBLIC_BROWSE_URL=https://spinauto.ca/cars

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Facebook Listings (Graph API) ────────────────────────────────────────────
# Until a real Meta app is configured, the Facebook feature runs in DEV MODE:
# "Connect" mints a mock Page and no real Graph calls are made. To go live
# (Phase 0b+): create a Meta app + Business, complete Business Verification,
# set up a Facebook Login for Business configuration, then fill these in.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CONFIG_ID=your_facebook_config_id
FACEBOOK_API_VERSION=v20.0
FACEBOOK_REDIRECT_URI=http://localhost:8080/facebook/connect/callback
# Webhook verify token (used in Phase 0b for the GET-challenge handshake).
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token
# 32-byte hex key for AES-256-GCM encryption of stored Page tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty in dev is OK (a derived dev key is used); production MUST set a real key.
FACEBOOK_TOKEN_ENC_KEY=

# ─── AWS S3 (vehicle media) ───────────────────────────────────────────────────
# Public-read bucket for vehicle images so Facebook can fetch them by URL.
# Leave S3_BUCKET EMPTY to use local-disk storage (./uploads, dev only).
# Setup: create a bucket with a public-read bucket policy (s3:GetObject for *)
# and an IAM user with s3:PutObject/DeleteObject/GetObject on the bucket.
# S3_PUBLIC_BASE_URL is optional (CloudFront/custom domain); else the default
# https://<bucket>.s3.<region>.amazonaws.com is used.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── Google Ads (read-only analytics) ─────────────────────────────────────────
# Until these are set, Marketing → Ads runs in DEV MODE (mock analytics; no API
# calls). Setup: in Google Cloud, enable the Google Ads API + create an OAuth
# "Web application" client (redirect = GOOGLE_ADS_REDIRECT_URI below); apply for
# a developer token in the Google Ads Manager (MCC) API Center.
#   • LOGIN_CUSTOMER_ID = your Manager (MCC) id (digits only).
#   • CUSTOMER_ID       = the ad account to report on (bound on connect).
# The per-account refresh token is minted in-app when you click Connect.
# NOTE: a new developer token has TEST-only access — querying a real account
# returns DEVELOPER_TOKEN_NOT_APPROVED until Basic Access is granted.
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8080/marketing/connect/google/callback
GOOGLE_ADS_API_VERSION=v21

# ─── Meta Ads (read-only analytics) ───────────────────────────────────────────
# Reuses the existing Meta app by default (FACEBOOK_APP_ID/SECRET) — just add
# the `ads_read` permission to that app. Set META_ADS_* only to override.
# META_ADS_ACCOUNT_ID is the ad account bound on connect (act_<id> or digits).
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCOUNT_ID=
META_ADS_API_VERSION=v20.0
META_ADS_REDIRECT_URI=http://localhost:8080/marketing/connect/meta/callback

# Ad-platform OAuth tokens are AES-256-GCM encrypted at rest reusing
# FACEBOOK_TOKEN_ENC_KEY (above). Production MUST set a real 32-byte hex key.
