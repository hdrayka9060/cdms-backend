# Environment Variables
# Copy this file to .env and fill in the values

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=CDMS Backend
API_PREFIX=api

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Fill in your MongoDB Atlas connection string
MONGODB_URI=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_very_strong_access_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail (Nodemailer) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="CDMS System <noreply@cdms.com>"

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
