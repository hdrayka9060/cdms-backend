# Environment Variables
# Copy this file to .env and fill in the values

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=CDMS Backend
API_PREFIX=api

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Fill in your MongoDB Atlas connection string
MONGODB_URI=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_very_strong_access_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Mail (Nodemailer) ────────────────────────────────────────────────────────
# Until MAIL_USER/MAIL_PASS are set to real values, the mail service runs in
# "dev mode" — invite & password-reset links are logged to the backend console
# instead of dispatched. To enable real mail, fill in real SMTP creds (Gmail
# requires a 16-char App Password — see backend MailService docstring).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="hdrayka9060@gmail.com"
MAIL_PASS="stgzaqmvrwmbwjkq"
MAIL_FROM="CDMS System <noreply@cdms.com>"

# ─── Frontend URL (used to build invite/reset links) ──────────────────────────
FRONTEND_URL=http://localhost:8080

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
